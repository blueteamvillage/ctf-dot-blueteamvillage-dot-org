# Contentful (build-time content fetch). Real values live in Vercel env vars —
# never commit them. The site builds without these (falls back to checked-in defaults).
CONTENTFUL_SPACE_ID=
CONTENTFUL_DELIVERY_TOKEN=
CONTENTFUL_ENVIRONMENT=master

# Optional build-time override for the announcement banner: "on" forces it,
# "off" hides it, unset defers to the siteSettings toggle in Contentful.
# The site is fully static — changing this takes effect on the next build.
ANNOUNCEMENT_BANNER=
